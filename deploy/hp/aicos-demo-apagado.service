# Acción del apagado programado: detiene la demo y retira SOLO su unidad Quadlet (para que no reaparezca al reiniciar). No toca ningún otro servicio.
# El volumen con los datos ficticios (aicos-demo-data) y la imagen se conservan; se borran a mano si se quiere (ver README.md).
[Unit]
Description=Apagado programado de la demo publica de AI Company OS

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --user stop aicos-demo.service
ExecStart=/usr/bin/rm -f %h/.config/containers/systemd/aicos-demo.container
ExecStart=/usr/bin/systemctl --user daemon-reload
ExecStart=/usr/bin/systemctl --user disable aicos-demo-apagado.timer
